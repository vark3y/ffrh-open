# Copy to .env (never committed). All optional.
# Protected-layer demo gate (a shared word for the demo; not a security boundary).
FFRH_HUB_TOKEN=ffrh-demo
# Model used for first-pass drafts. Credentials are NOT set here: run `ant auth login` once on this
# machine (browser sign-in to your Claude Console account), or export ANTHROPIC_API_KEY in your shell.
FFRH_DRAFT_MODEL=claude-opus-5
# Point at your own copies of the raw public files if not in data/raw/.
# FFRH_MCA_CSV=/path/to/mca_csr_master.csv
# FFRH_DARPAN_CSV=/path/to/ngo_darpan_grants.csv
